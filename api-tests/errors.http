### ============================================================
### Error cases — verify the frozen ApiError envelope
### ============================================================

@baseUrl = http://localhost:8080

### 400 — validation error (blank title)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "bad@example.com",
  "password": "short",
  "displayName": ""
}

### 400 — malformed JSON
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{ "email": "bad"

### 401 — task endpoint without token
GET {{baseUrl}}/api/v1/tasks

### 409 — duplicate email (run register twice)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "dave@example.com",
  "password": "password123",
  "displayName": "Dave"
}